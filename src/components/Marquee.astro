---
const items = [
  'Ripley',
  'Falabella',
  'Real Plaza',
  'Shopstar',
  'Mercado Libre',
  'Amazon',
  'Rappi',
  'VTEX',
  'WooCommerce',
  'eBay',
  'TikTok Shop',
  'Tu tienda propia',
];
---
<section class="mq" aria-label="Canales donde puedes usar tus archivos">
  <p class="label reveal"><span>Úsalo en los canales donde ya vendes</span></p>
  <div class="track">
    <ul class="row">
      {items.map((i) => <li>{i}</li>)}
      {items.map((i) => <li class="dup" aria-hidden="true">{i}</li>)}
    </ul>
  </div>
</section>
<style>
  .mq { border-block: 1px solid var(--line); background: #fff; padding-block: 2rem 2.2rem; overflow: hidden; }
  .label { display: flex; align-items: center; justify-content: center; gap: 1.2rem; margin: 0 auto 1.4rem; width: min(100% - 2.5rem, 640px); font: 600 .75rem var(--font-head); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .label::before, .label::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, var(--line)); }
  .label::after { background: linear-gradient(270deg, transparent, var(--line)); }
  .label span { white-space: nowrap; }

  .track { mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .row { list-style: none; margin: 0; padding: 0; display: flex; width: max-content; animation: scroll 60s linear infinite; }
  .track:hover .row { animation-play-state: paused; }
  .row li { display: inline-flex; align-items: center; white-space: nowrap; padding-right: 3rem; font: 700 1.3rem var(--font-head); letter-spacing: -0.03em; color: #7c83a8; transition: color .2s; }
  .row li::after { content: ''; width: 5px; height: 5px; margin-left: 3rem; border-radius: 50%; background: var(--accent); opacity: .7; }
  .row li:hover { color: var(--blue); }
  @keyframes scroll { to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .track { mask-image: none; }
    .row { width: auto; flex-wrap: wrap; justify-content: center; row-gap: .8rem; padding-inline: 1.25rem; }
    .dup { display: none; }
  }
</style>