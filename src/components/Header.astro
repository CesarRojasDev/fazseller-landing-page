---
import Logo from './Logo.astro';
const links = [
  { href: '#herramientas', label: 'Herramientas' },
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#planes', label: 'Planes' },
  { href: '#proximamente', label: 'Próximamente' },
  { href: '#faq', label: 'FAQ' },
];
---
<header class="hdr">
  <div class="container bar">
    <Logo />
    <nav aria-label="Principal">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a href="#empezar" class="btn btn-primary cta">Empezar gratis</a>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; backdrop-filter: saturate(160%) blur(14px); background: rgb(255 255 255 / .72); border-bottom: 1px solid rgb(227 230 243 / .7); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 1rem; }
  nav { display: flex; gap: 2rem; }
  nav a { font-weight: 500; font-size: .95rem; color: var(--muted); transition: color .2s; }
  nav a:hover { color: var(--blue); }
  .cta { padding: .75rem 1.2rem; font-size: .9rem; }
  @media (max-width: 820px) { nav { display: none; } }
</style>
