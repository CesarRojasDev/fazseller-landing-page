---
import Icon from './Icon.astro';
const cols = [
  { icon: 'spark', title: 'Si estás empezando', points: ['Plantillas listas, sin curva de aprendizaje', 'Aprende buenas prácticas de SKU y etiquetado', 'Luce profesional desde tu primera venta'] },
  { icon: 'rocket', title: 'Si ya vendes a escala', points: ['Trabajo en lote con miles de productos', 'Reglas y formatos personalizados', 'Procesos consistentes en todos tus canales'] },
];
---
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Para cada seller</span>
      <h2>Crece a tu ritmo, <span class="grad-text">sin cambiar de herramienta</span></h2>
    </div>
    <div class="cols">
      {cols.map((c, i) => (
        <article class="col reveal" style={`--d:${i * 120}ms`}>
          <span class="ic"><Icon name={c.icon} size={26} /></span>
          <h3>{c.title}</h3>
          <ul>{c.points.map((p) => <li><Icon name="check" size={18} /> {p}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .cols { margin-top: 3rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .col { border-radius: var(--radius); padding: 2.2rem; border: 1px solid var(--line); background: #fff; display: grid; gap: 1rem; align-content: start; }
  .col:last-child { background: linear-gradient(150deg, var(--blue), var(--navy)); color: #fff; border: 0; }
  .col:last-child h3 { color: #fff; } .col:last-child li :global(svg) { color: #a9b3ff; }
  .ic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--blue-soft); color: var(--blue); }
  .col:last-child .ic { background: rgb(255 255 255 / .15); color: #fff; }
  h3 { font-size: 1.5rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .8rem; }
  li { display: flex; gap: .7rem; align-items: flex-start; }
  li :global(svg) { color: var(--blue); flex: none; margin-top: .2rem; }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr; } }
</style>
