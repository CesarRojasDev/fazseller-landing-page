---
import Icon from './Icon.astro'
---

<section class='section alt' id='como-funciona'>
  <div class='container'>
    <div class='section-head reveal'>
      <span class='eyebrow'>Cómo funciona</span>
      <h2>
        De tu lista de productos a archivos listos en <span class='grad-text'
          >3 pasos</span>
      </h2>
      <p>Sin curva de aprendizaje ni configuraciones largas.</p>
    </div>

    <ol class='steps'>
      <!-- PASO 1 -->
      <li class='step reveal' style='--d:0ms'>
        <header>
          <span class='n'>01</span>
          <div>
            <h3>Carga tus productos</h3>
            <p>Importa tu Excel o CSV, o regístralos a mano. Sin configuraciones largas.</p>
          </div>
        </header>
        <div class='vis v1' aria-hidden='true'>
          <div class='opt'>
            <span class='opt-t'
              ><Icon name='download' size={14} /> Importar archivo</span
            >
            <div class='drop'>
              <span class='file'><b>XLSX</b> productos.xlsx</span>
              <div class='bar'><i></i></div>
              <small>248 productos detectados</small>
            </div>
          </div>
          <span class='or'>o</span>
          <div class='opt'>
            <span class='opt-t'
              ><Icon name='plus' size={14} /> Registro manual</span
            >
            <div class='form'>
              <div class='fld'>
                <small>Producto</small><span>Polo azul M</span>
              </div>
              <div class='fld'><small>Precio</small><span>$24.90</span></div>
              <span class='add'>+ Agregar</span>
            </div>
          </div>
        </div>
      </li>

      <!-- PASO 2 -->
      <li class='step reveal' style='--d:110ms'>
        <header>
          <span class='n'>02</span>
          <div>
            <h3>Elige qué generar</h3>
            <p>Catálogo, etiquetas o SKU, con plantillas listas para usar.</p>
          </div>
        </header>
        <div class='vis v2' aria-hidden='true'>
          <div class='tool'>
            <span class='ti'><Icon name='book' size={20} /></span> Catálogo
          </div>
          <div class='tool on'>
            <span class='ti'><Icon name='label' size={20} /></span> Etiquetas <Icon
              name='check'
              size={18}
              class='ck'
            />
          </div>
          <div class='tool'>
            <span class='ti'><Icon name='barcode' size={20} /></span> SKU
          </div>
          <div class='tpl'><i></i><i></i><i></i></div>
        </div>
      </li>

      <!-- PASO 3 -->
      <li class='step reveal' style='--d:220ms'>
        <header>
          <span class='n'>03</span>
          <div>
            <h3>Descarga y empieza a vender</h3>
            <p>Tus archivos listos en segundos para usar en tus canales de venta.</p>
          </div>
        </header>
        <div class='vis v3' aria-hidden='true'>
          <div class='dl'>
            <span class='ft pdf'>PDF</span><span class='fn'>catalogo.pdf</span
            ><span class='go'><Icon name='download' size={16} /></span>
          </div>
          <div class='dl'>
            <span class='ft pdf'>PDF</span><span class='fn'>etiquetas.pdf</span
            ><span class='go'><Icon name='download' size={16} /></span>
          </div>
          <div class='dl'>
            <span class='ft csv'>CSV</span><span class='fn'>skus.csv</span><span
              class='go'><Icon name='download' size={16} /></span>
          </div>
          <div class='mk'>
            <span>Amazon</span><span>Mercado Libre</span><span>Shopee</span
            ><span>+</span>
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .alt {
    background: var(--snow);
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.4rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem;
  }
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -1.2rem;
    width: 1.2rem;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      var(--blue) 0 4px,
      transparent 4px 8px
    );
  }
  header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
  }
  .n {
    font: 800 2.6rem/1 var(--font-head);
    letter-spacing: -0.05em;
    background: linear-gradient(180deg, var(--blue), transparent 130%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h3 {
    font-size: 1.2rem;
  }
  header p {
    color: var(--muted);
    font-size: 0.92rem;
    margin-top: 0.3rem;
  }

  .vis {
    border-radius: 14px;
    background: linear-gradient(160deg, #f4f5ff, #eaedff);
    border: 1px solid var(--line);
    padding: 1rem;
    display: grid;
    gap: 0.6rem;
    align-content: center;
    font-size: 0.8rem;
  }
  small {
    color: var(--muted);
    font-size: 0.7rem;
  }

  /* Paso 1 */
  .opt {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.75rem;
    display: grid;
    gap: 0.55rem;
    box-shadow: var(--shadow-sm);
  }
  .opt-t {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: 600 0.75rem var(--font-head);
    color: var(--blue);
  }
  .drop {
    border: 1.5px dashed #aab2e8;
    border-radius: 10px;
    padding: 0.65rem;
    display: grid;
    gap: 0.4rem;
  }
  .file {
    font-weight: 500;
    color: var(--deep-blue);
  }
  .file b {
    background: #e3f6ea;
    color: var(--ok);
    font: 700 0.62rem var(--font-head);
    padding: 0.15rem 0.35rem;
    border-radius: 5px;
    margin-right: 0.4rem;
  }
  .bar {
    height: 5px;
    border-radius: 4px;
    background: var(--line);
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--blue);
    border-radius: 4px;
    transform-origin: left;
    animation: load 3.5s ease-in-out infinite;
  }
  .or {
    text-align: center;
    font: 600 0.7rem var(--font-head);
    color: var(--muted);
    text-transform: uppercase;
  }
  .form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.4rem;
    align-items: end;
  }
  .fld {
    display: grid;
    gap: 0.15rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.35rem 0.5rem;
  }
  .fld span {
    color: var(--deep-blue);
    font-weight: 500;
  }
  .add {
    grid-column: 1 / -1;
    text-align: center;
    background: var(--blue);
    color: #fff;
    font: 600 0.72rem var(--font-head);
    padding: 0.45rem;
    border-radius: 8px;
  }

  /* Paso 2 */
  .tool {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: #fff;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 0.6rem 0.7rem;
    font: 600 0.85rem var(--font-head);
    color: var(--deep-blue);
  }
  .ti {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--blue-soft);
    color: var(--blue);
  }
  .tool.on {
    border-color: var(--blue);
    box-shadow: 0 0 0 4px rgb(19 19 242 / 0.1);
    animation: pick 3.5s ease-in-out infinite;
  }
  .tool :global(.ck) {
    margin-left: auto;
    color: var(--blue);
  }
  .tpl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-top: 0.2rem;
  }
  .tpl i {
    aspect-ratio: 3/2;
    border-radius: 8px;
    background: #fff;
    border: 1px solid var(--line);
    background-image: repeating-linear-gradient(
      90deg,
      var(--deep-blue) 0 2px,
      transparent 2px 5px
    );
    background-size: 60% 30%;
    background-repeat: no-repeat;
    background-position: center 80%;
  }
  .tpl i:first-child {
    border-color: var(--blue);
  }

  /* Paso 3 */
  .dl {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.6rem;
    align-items: center;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.55rem 0.65rem;
  }
  .ft {
    font: 700 0.65rem var(--font-head);
    padding: 0.3rem 0.45rem;
    border-radius: 6px;
  }
  .pdf {
    background: #ffe9e9;
    color: #d33;
  }
  .csv {
    background: #e3f6ea;
    color: var(--ok);
  }
  .fn {
    color: var(--deep-blue);
    font-weight: 500;
  }
  .go {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--blue);
    color: #fff;
  }
  .mk {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.2rem;
  }
  .mk span {
    font: 600 0.68rem var(--font-head);
    color: var(--navy);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
  }

  /* Entrada escalonada de los elementos internos */
  .vis > *,
  .opt > *,
  .drop > *,
  .form > * {
    opacity: 0;
    transform: translateY(14px) scale(0.97);
    transition:
      opacity 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .step.in .vis > *,
  .step.in .opt > *,
  .step.in .drop > *,
  .step.in .form > * {
    opacity: 1;
    transform: none;
  }
  .step.in .vis > :nth-child(1) {
    transition-delay: calc(var(--d) + 250ms);
  }
  .step.in .vis > :nth-child(2) {
    transition-delay: calc(var(--d) + 380ms);
  }
  .step.in .vis > :nth-child(3) {
    transition-delay: calc(var(--d) + 510ms);
  }
  .step.in .vis > :nth-child(4) {
    transition-delay: calc(var(--d) + 640ms);
  }
  .step.in .opt > *,
  .step.in .drop > *,
  .step.in .form > * {
    transition-delay: calc(var(--d) + 450ms);
  }
  html:not(.js) .vis > *,
  html:not(.js) .opt > *,
  html:not(.js) .drop > *,
  html:not(.js) .form > * {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .vis > *,
    .opt > *,
    .drop > *,
    .form > * {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes load {
    0% {
      transform: scaleX(0);
    }
    60%,
    100% {
      transform: scaleX(1);
    }
  }
  @keyframes pick {
    50% {
      box-shadow: 0 0 0 7px rgb(19 19 242 / 0.05);
    }
  }

  @media (max-width: 980px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .step::after {
      display: none;
    }
  }
</style>