---
import { faqs } from '../data/content';
---
<section class="section" id="faq">
  <div class="container narrow">
    <div class="section-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2>Preguntas <span class="grad-text">frecuentes</span></h2>
    </div>
    <div class="list">
      {faqs.map((f) => (
        <details class="reveal">
          <summary>{f.q}<span class="pm" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })} />
</section>
<style>
  .narrow { max-width: 820px; }
  .list { margin-top: 2.5rem; display: grid; gap: .8rem; }
  details { border: 1px solid var(--line); border-radius: 16px; background: #fff; transition: border-color .2s, box-shadow .2s; }
  details[open] { border-color: #c9d0ff; box-shadow: var(--shadow-sm); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.25rem 1.5rem; font: 600 1.05rem var(--font-head); color: var(--deep-blue); }
  summary::-webkit-details-marker { display: none; }
  .pm { position: relative; width: 14px; height: 14px; flex: none; }
  .pm::before, .pm::after { content: ''; position: absolute; inset: 6px 0 auto; height: 2px; background: var(--blue); border-radius: 2px; transition: transform .25s; }
  .pm::after { transform: rotate(90deg); }
  details[open] .pm::after { transform: rotate(0); }
  details p { padding: 0 1.5rem 1.4rem; color: var(--muted); }
</style>
